{
  "compilerOptions": {
    "experimentalDecorators": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "target": "es2015",
    "declaration": true,
    "downlevelIteration": true,
    "lib": ["es2017", "dom"],
    "types": ["node", "mocha"]
  },
  "include": ["./src/*"],
  "exclude": ["node_modules","test", "**/*.test.ts"]
}
